	$(MAKE) $(MAKESILENT) -f CMakeFiles/cubrid-odbc-test.dir/build.make CMakeFiles/cubrid-odbc-test.dir/test_util.c.i
.PHONY : test_util.c.i

test_util.s: test_util.c.s
.PHONY : test_util.s

# target to generate assembly for a file
test_util.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/cubrid-odbc-test.dir/build.make CMakeFiles/cubrid-odbc-test.dir/test_util.c.s
.PHONY : test_util.c.s

